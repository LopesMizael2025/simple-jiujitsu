# ---------------------------------------------------------------------------
# Supabase — pegue em: Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Modelos de reconhecimento facial
# Padrão: CDN (funciona sem configurar nada).
# Para hospedar junto do app: rode `npm run models:download` e troque para /models
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FACE_MODELS_URL=https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.15/model

# ---------------------------------------------------------------------------
# Login
# whatsapp = OTP por WhatsApp (exige Twilio Verify configurado no Supabase)
# email    = link mágico por e-mail (funciona de imediato, bom para testar)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AUTH_MODE=whatsapp
